# 主机看门狗定时器：开机 3 分钟后首跑，之后每 2 分钟一次

[Unit]
Description=Run VoiceHub watchdog every 2 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=15s
Unit=voicehub-watchdog.service

[Install]
WantedBy=timers.target
