# VoiceHub 运维自动化配置模板
#
# 用法：复制为 /etc/voicehub/automation.env，chmod 600，按实际环境填写。
#       脚本通过 VH_AUTOMATION_ENV 可指定其他路径。
#
# 重要：本文件与仓库内所有文件都不得包含真实密钥、密码、令牌或私钥。
#       下面用 <...> 表示占位符；凭据只放在外部文件里，这里只写"路径"。
#       填写后的 automation.env 不要提交到任何仓库（见 .gitignore）。

# ---- 部署路径 ----
VH_HOME=/srv/voicehub

# ---- 站点信息（巡检与告警使用）----
VH_SITE_URL=https://<your-domain>
VH_SITE_HOST=<your-domain>
VH_WWW_URL=https://www.<your-domain>
# 站点归属验证文件：由 nginx 直接返回、不受地域闸影响，巡检用它判断公网链路
VH_VERIFY_PATH=/<verification-file>.txt
VH_VERIFY_SHA=<expected-content>
# 仅用于告警正文展示，可留空
VH_PUBLIC_IP=<your-public-ip>

# ---- 凭据载体：只填路径，绝不填值 ----
# coscmd 配置文件，600 权限，内含 COS SecretId / SecretKey
VH_COS_CONF=/root/.cos.conf

# 运维告警投递程序：把仓库 deploy/automation/mailer/voicehub-mailer.py 复制到主机并设为可执行，
# 路径填这里。它沿用 argv[1]=主旨、stdin=正文 的调用契约，不含任何 SMTP 凭据，
# 只把告警 POST 到应用内部接口，由 VoiceHub 站内 SMTP 代发（发件人/收件人在后台配置）。
VH_MAIL_BIN=/usr/local/bin/<mailer-script>

# 应用内部接口令牌：与 VoiceHub 应用 env 的 ATTACK_LOG_TOKEN 同值。
# 仅放在本文件（600）或以环境变量传入；绝不写入仓库、绝不出现在日志。
ATTACK_LOG_TOKEN=<ops-alert-token>

# 可选：覆盖应用内部接口地址（默认 http://127.0.0.1:3000/api/internal/ops-alert）
# VH_OPS_ALERT_URL=http://127.0.0.1:3000/api/internal/ops-alert

# ---- 主机看门狗（08-watchdog.sh，可选，均有默认值）----
# 连续失败几次后重启、两次自动重启的最小间隔（秒）、磁盘告警阈值（%）
# VH_HEALTH_URL=http://127.0.0.1:3000/api/health
# VH_MAX_FAILS=2
# VH_RESTART_COOLDOWN=300
# VH_DISK_MAX_PERCENT=90
# 磁盘告警冷却（秒）：清理动作每轮照做，但邮件同一告警默认 1 小时内只发一次
# VH_DISK_ALERT_COOLDOWN=3600
# 检查哪个分区：备份与镜像通常落在数据盘，默认 /（VH_HOME 在独立盘时应改这里）
# VH_DISK_MOUNT_POINT=/
# VH_STATE_DIR=/var/lib/voicehub-watchdog

# WAF 入口探测（默认由 VH_SITE_HOST 推导为 https://<域名>/api/health）
# 用于发现「应用活着但 tengine 挂了」的盲区；连续失败达阈值且应用直连健康时重启 tengine
# 主机名只接受域名或 IPv4（不含下划线，TLS 证书不会匹配），端口非 443 时用 VH_WAF_PORT 指定
# VH_WAF_URL=https://<your-domain>/api/health
# VH_WAF_PORT=443
# VH_WAF_MAX_FAILS=3
# VH_WAF_RESTART_COOLDOWN=600
# safeline compose 所在目录（容器被删除时用于 compose 拉起；默认 /data/safeline）
# VH_SAFELINE_HOME=/data/safeline

# 内存告警阈值（%）：仅告警不重启，同一告警默认 30 分钟内只发一次
# VH_MEM_MAX_PERCENT=85
# VH_MEM_ALERT_COOLDOWN=1800

# 运维告警收件人：现可在 VoiceHub 后台「运维通知」配置，此值仅作回落
# （后台未配置收件人时，应用内部接口回落到这里的逗号分隔邮箱列表）
# VH_MAIL_TO=<ops-alert-recipient@example.com>

# ---- 备份策略 ----
VH_KEEP_DAYS=14
VH_KEEP_COPIES=14
VH_COS_PREFIX=voicehub/

# ---- 放行 IP 库更新（可选功能，见 README）----
# VH_GEO_CIDR_FILE=$VH_HOME/rewriter/geo-allow-cidrs.txt
# VH_GEO_STATE_FILE=$VH_HOME/rewriter/state/geo-lock.json
# 健康检查时伪装的中国大陆客户端 IP（期望放行）
VH_PROBE_IP=223.5.5.5
# 地域闸开启时用于复验的境外测试 IP（期望被拦截，公共 DNS 地址，非凭据）
VH_DENY_PROBE_IP=8.8.8.8

# ---- 巡检：允许的公网监听端口（grep -E 正则，含 | 必须加引号）----
# 保持最小集：SSH 端口 + Cloudflare 回源 HTTP/HTTPS。
# 不要加入应用、rewriter、数据库、缓存或任何测试站端口，否则新增暴露面会被漏报。
# <ssh-port> 请替换为实际 SSH 监听端口；示例占位值不可直接用于巡检。
VH_EXPECTED_PORTS="<ssh-port>|80|443"

# ---- 其他可选 ----
# VH_DB_USER / VH_DB_NAME 等常量目前写在脚本里，若部署不同请同步修改脚本
# 09-backup-drill.sh 额外支持 VH_PG_CONTAINER / VH_DB_NAME / VH_DB_USER / VH_DRILL_DB 覆盖
