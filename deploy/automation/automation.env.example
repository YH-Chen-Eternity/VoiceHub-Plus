# VoiceHub 运维自动化配置模板
#
# 用法：复制为 /etc/voicehub/automation.env，chmod 600，按实际环境填写。
#       脚本通过 VH_AUTOMATION_ENV 可指定其他路径。
#
# 重要：本文件与仓库内所有文件都不得包含真实密钥、密码、令牌或私钥。
#       下面用 <...> 表示占位符；凭据只放在外部文件里，这里只写"路径"。
#       填写后的 automation.env 不要提交到任何仓库（见 .gitignore）。

# ---- 部署路径 ----
VH_HOME=/srv/voicehub

# ---- 站点信息（巡检与告警使用）----
VH_SITE_URL=https://<your-domain>
VH_SITE_HOST=<your-domain>
VH_WWW_URL=https://www.<your-domain>
# 站点归属验证文件：由 nginx 直接返回、不受地域闸影响，巡检用它判断公网链路
VH_VERIFY_PATH=/<verification-file>.txt
VH_VERIFY_SHA=<expected-content>
# 仅用于告警正文展示，可留空
VH_PUBLIC_IP=<your-public-ip>

# ---- 凭据载体：只填路径，绝不填值 ----
# coscmd 配置文件，600 权限，内含 COS SecretId / SecretKey
VH_COS_CONF=/root/.cos.conf
# 邮件发送脚本，600 权限，SMTP 账号/授权码由该脚本自行读取
VH_MAIL_BIN=/usr/local/bin/<mailer-script>

# ---- 备份策略 ----
VH_KEEP_DAYS=14
VH_KEEP_COPIES=14
VH_COS_PREFIX=voicehub/

# ---- 放行 IP 库更新（可选功能，见 README）----
# VH_GEO_CIDR_FILE=$VH_HOME/rewriter/geo-allow-cidrs.txt
# VH_GEO_STATE_FILE=$VH_HOME/rewriter/state/geo-lock.json
# 健康检查时伪装的中国大陆客户端 IP（期望放行）
VH_PROBE_IP=223.5.5.5
# 地域闸开启时用于复验的境外测试 IP（期望被拦截，公共 DNS 地址，非凭据）
VH_DENY_PROBE_IP=8.8.8.8

# ---- 巡检：允许的公网监听端口（grep -E 正则，含 | 必须加引号）----
# 保持最小集：SSH 端口 + Cloudflare 回源 HTTP/HTTPS。
# 不要加入应用、rewriter、数据库、缓存或任何测试站端口，否则新增暴露面会被漏报。
# <ssh-port> 请替换为实际 SSH 监听端口；示例占位值不可直接用于巡检。
VH_EXPECTED_PORTS="<ssh-port>|80|443"

# ---- 其他可选 ----
# VH_DB_USER / VH_DB_NAME 等常量目前写在脚本里，若部署不同请同步修改脚本
